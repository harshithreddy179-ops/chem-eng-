# ─── Supabase ────────────────────────────────────────────────────────────────
# Project Settings → API. The anon key is safe to expose (RLS protects data).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# ─── Site ───────────────────────────────────────────────────────────────────
# Canonical URL used for metadata, sitemap and OpenGraph.
NEXT_PUBLIC_SITE_URL=https://the-chemical-archive.vercel.app

# NOTE: The service-role key is NOT required by this app and must never be
# added with a NEXT_PUBLIC_ prefix. All admin writes go through the signed-in
# admin's session and are enforced by Row Level Security.
